{
  "name": "yagodka-client-web",
  "private": true,
  "version": "0.1.804",
  "description": "Yagodka web and desktop client",
  "license": "GPL-3.0-or-later",
  "author": "Yagodka",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "postinstall": "node scripts/postinstall.mjs",
    "build": "vite build && node scripts/build_skins.mjs && node scripts/build_pwa.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "desktop:dev": "electron desktop/main.cjs",
    "desktop:build": "npm run build && electron-builder --dir",
    "desktop:build:unsigned": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir --mac",
    "desktop:dist": "npm run build && electron-builder",
    "desktop:dist:mac": "npm run build && electron-builder --mac dmg zip",
    "desktop:dist:mac:unsigned": "npm run desktop:build:unsigned && node scripts/build_unsigned_mac_feed.mjs",
    "desktop:publish:mac": "npm run build && electron-builder --mac dmg zip --publish always",
    "desktop:dist:win": "npm run build && electron-builder --win nsis",
    "desktop:dist:linux": "npm run build && electron-builder --linux AppImage deb",
    "android:sync": "npm run build && cap sync android",
    "android:open": "npm run android:sync && cap open android",
    "android:build:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/run_tests.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^42.0.0",
    "electron-builder": "26.8.1",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.11"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "electron-updater": "^6.8.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "overrides": {
    "picomatch": "^4.0.4",
    "postcss": "^8.5.12",
    "rollup": "^4.59.0"
  }
}
